# Copy to .env for local development. NEVER commit .env. All values below are placeholders.

# Which settings module to use: config.settings.development | config.settings.production
DJANGO_SETTINGS_MODULE=config.settings.development

SECRET_KEY=replace-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# PostgreSQL (recommended for development too). Leave empty to fall back to SQLite in development only.
DATABASE_URL=postgres://astravia:password@127.0.0.1:5432/astravia

# Initial owner account (used by: python manage.py create_owner --from-env)
ASTRAVIA_OWNER_EMAIL=
ASTRAVIA_OWNER_PASSWORD=

# Email. Leave EMAIL_HOST empty in development to print emails to the console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ASTRAVIA <no-reply@example.invalid>

# Media storage: "local" (MEDIA_ROOT, e.g. a Render persistent disk) or "s3" (requires requirements-s3.txt)
MEDIA_STORAGE=local
MEDIA_ROOT=
SERVE_MEDIA=False
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_CUSTOM_DOMAIN=

# Optional voice provider (no provider ships enabled; see docs/CREATOR_STUDIO_GUIDE.md)
VOICE_PROVIDER=
VOICE_PROVIDER_API_KEY=

# Optional AI dialogue provider for guide assistants (disabled unless configured)
GUIDE_AI_PROVIDER=
GUIDE_AI_API_KEY=

# Public site URL, used for canonical URLs and sitemaps (no trailing slash). Leave empty until a domain exists.
SITE_URL=
